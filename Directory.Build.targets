<Project>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts\packages</PackageOutputPath>
  </PropertyGroup>

  <!-- Fail fast if a packable project is missing critical NuGet metadata. -->
  <Target Name="ValidatePackageMetadata" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(PackageId)' == ''" Text="PackageId must be set before packing." />
    <Error Condition="'$(Description)' == ''" Text="Description must be set before packing." />
    <Error Condition="'$(Authors)' == ''" Text="Authors must be set before packing." />
    <Error Condition="'$(RepositoryUrl)' == ''" Text="RepositoryUrl must be set before packing (needed by SourceLink)." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Description)', '_{2}'))" Text="Description contains an unresolved template placeholder." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(Authors)', '_{2}'))" Text="Authors contains an unresolved template placeholder." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(RepositoryUrl)', '_{2}'))" Text="RepositoryUrl contains an unresolved template placeholder." />
    <Error Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(PackageTags)', '_{2}'))" Text="PackageTags contains an unresolved template placeholder." />
  </Target>

</Project>
